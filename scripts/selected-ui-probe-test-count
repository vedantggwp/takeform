#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -ne 1 ]; then
  echo "Usage: $0 XCODEBUILD_LOG" >&2
  exit 2
fi

awk '
  /Test Suite .Selected tests. (passed|failed) / { selected = 1; next }
  selected && /Executed [0-9]+ test(s)?/ { print $2; found = 1; exit }
  END { if (!found) print 0 }
' "$1"
