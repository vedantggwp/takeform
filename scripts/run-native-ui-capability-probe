#!/usr/bin/env bash
set -uo pipefail

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PROJECT="$ROOT_DIR/Tests/native-ui-capability/TakeformNativeUICapability.xcodeproj"
SCHEME="TakeformNativeUICapability"
MODE="${1:-run}"
OUTPUT_DIR="${TAKEFORM_UI_PROBE_OUTPUT:-}"
APP_BUNDLE="${TAKEFORM_UI_PROBE_APP:-}"
SOURCE_SHA="${TAKEFORM_UI_PROBE_SOURCE_SHA:-}"
TIMEOUT_SECONDS="${TAKEFORM_UI_PROBE_TIMEOUT_SECONDS:-180}"
FAILED_LANES_ONLY="${TAKEFORM_UI_PROBE_FAILED_LANES_ONLY:-0}"
DISPLAY_MODE_ALLOWED="${TAKEFORM_UI_PROBE_ALLOW_DISPLAY_MODE:-0}"

if [ "$MODE" != "run" ] && [ "$MODE" != "--build-for-testing" ]; then
  echo "Usage: $0 [--build-for-testing]" >&2
  exit 2
fi
if [ -z "$OUTPUT_DIR" ]; then
  echo "TAKEFORM_UI_PROBE_OUTPUT is required" >&2
  exit 2
fi
if ! [[ "$TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]]; then
  echo "TAKEFORM_UI_PROBE_TIMEOUT_SECONDS must be a positive integer" >&2
  exit 2
fi
if [ ! -d "$PROJECT" ]; then
  echo "Missing UI test project: $PROJECT" >&2
  exit 2
fi
if [ "$MODE" = run ] && [ ! -d "$APP_BUNDLE" ]; then
  echo "TAKEFORM_UI_PROBE_APP must name a copied app bundle" >&2
  exit 2
fi

mkdir -p "$OUTPUT_DIR"
RESULT_BUNDLE="$OUTPUT_DIR/native-ui-capability.xcresult"
DERIVED_DATA="$OUTPUT_DIR/DerivedData"
LOG="$OUTPUT_DIR/xcodebuild.log"
FACTS="$OUTPUT_DIR/facts.txt"
ATTACHMENTS="$OUTPUT_DIR/attachments"

rm -rf "$RESULT_BUNDLE" "$DERIVED_DATA" "$ATTACHMENTS"
{
  echo "source_sha: ${SOURCE_SHA:-$(git -C "$ROOT_DIR" rev-parse HEAD)}"
  echo "actual_source_sha: $(git -C "$ROOT_DIR" rev-parse HEAD)"
  echo "mode: $MODE"
  echo "failed_lanes_only: $FAILED_LANES_ONLY"
  echo "display_mode_allowed: $DISPLAY_MODE_ALLOWED"
  xcodebuild -version
  sw_vers
  uname -m
  if [ "$MODE" = run ]; then
    /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$APP_BUNDLE/Contents/Info.plist"
    codesign -dvvv "$APP_BUNDLE" 2>&1 | grep -E 'Identifier=|CDHash=' || true
  fi
} > "$FACTS" 2>&1

action="test"
if [ "$MODE" = "--build-for-testing" ]; then
  action="build-for-testing"
fi
command=(
  xcodebuild "$action"
  -project "$PROJECT"
  -scheme "$SCHEME"
  -destination 'platform=macOS,arch=arm64'
  -parallel-testing-enabled NO
  -derivedDataPath "$DERIVED_DATA"
  -resultBundlePath "$RESULT_BUNDLE"
)
if [ "$FAILED_LANES_ONLY" = "1" ]; then
  command+=(
    '-only-testing:TakeformNativeUICapabilityTests/TakeformNativeUICapabilityTests/testKeyboardMenuTraversalOpensNativeAbout'
  )
fi

set -m
if [ "$MODE" = run ]; then
  TEST_RUNNER_TAKEFORM_UI_PROBE_APP="$APP_BUNDLE" \
    TEST_RUNNER_TAKEFORM_UI_PROBE_ALLOW_DISPLAY_MODE="$DISPLAY_MODE_ALLOWED" \
    "${command[@]}" > "$LOG" 2>&1 &
else
  "${command[@]}" > "$LOG" 2>&1 &
fi
pid=$!

collect_descendants() {
  local parent="$1"
  local child
  while IFS= read -r child; do
    [ -n "$child" ] || continue
    collect_descendants "$child"
    printf '%s\n' "$child"
  done < <(/usr/bin/pgrep -P "$parent" 2>/dev/null || true)
}

terminate_owned_processes() {
  local child
  local descendants=()
  while IFS= read -r child; do
    descendants+=("$child")
  done < <(collect_descendants "$pid")

  echo "timeout_cleanup: terminate requested" >> "$FACTS"
  kill -TERM -- "-$pid" 2>/dev/null || true
  if [ "${#descendants[@]}" -gt 0 ]; then
    kill -TERM "${descendants[@]}" 2>/dev/null || true
  fi
  sleep 2

  local survivors=()
  for child in "$pid" "${descendants[@]}"; do
    if kill -0 "$child" 2>/dev/null; then
      survivors+=("$child")
    fi
  done
  if [ "${#survivors[@]}" -gt 0 ]; then
    kill -KILL "${survivors[@]}" 2>/dev/null || true
    echo "timeout_cleanup: forced reaping for ${#survivors[@]} owned process(es)" >> "$FACTS"
  else
    echo "timeout_cleanup: all owned processes exited after TERM" >> "$FACTS"
  fi
}

deadline=$((SECONDS + TIMEOUT_SECONDS))
timed_out=0
while kill -0 "$pid" 2>/dev/null; do
  if [ "$SECONDS" -ge "$deadline" ]; then
    timed_out=1
    terminate_owned_processes
    break
  fi
  sleep 1
done
wait "$pid"
status=$?

if [ "$MODE" = run ] && [ "$FAILED_LANES_ONLY" = "1" ]; then
  expected_test_count=1
  executed_test_count="$("$ROOT_DIR/scripts/selected-ui-probe-test-count" "$LOG")"
  echo "expected_selected_test_count: $expected_test_count" >> "$FACTS"
  echo "observed_selected_test_count: $executed_test_count" >> "$FACTS"
  if [ "$executed_test_count" -ne "$expected_test_count" ]; then
    echo "probe_selection: expected $expected_test_count selected tests, observed $executed_test_count" >> "$FACTS"
    status=1
  fi
fi

if [ "$timed_out" -eq 1 ]; then
  echo "probe_timeout_seconds: $TIMEOUT_SECONDS" >> "$FACTS"
  status=124
fi
if [ -d "$RESULT_BUNDLE" ]; then
  if [ "$MODE" = run ]; then
    mkdir -p "$ATTACHMENTS"
    if ! xcrun xcresulttool export attachments --path "$RESULT_BUNDLE" --output-path "$ATTACHMENTS" >> "$LOG" 2>&1; then
      echo "attachment_export: failed" >> "$FACTS"
      status=1
    fi
  else
    echo "attachment_export: not_applicable" >> "$FACTS"
  fi
else
  echo "result_bundle: missing" >> "$FACTS"
  status=1
fi
if [ "$MODE" = run ] && ! find "$ATTACHMENTS" -type f -name '*.png' -print -quit | grep -q .; then
  echo "window_screenshot: missing" >> "$FACTS"
  status=1
fi

exit "$status"
