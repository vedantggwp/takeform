#!/usr/bin/env bash
set -uo pipefail

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
PROJECT="$ROOT_DIR/Tests/native-creator-walkthrough/TakeformNativeCreatorWalkthrough.xcodeproj"
SCHEME="TakeformNativeCreatorWalkthrough"
MODE="${1:-run}"
OUTPUT_DIR="${TAKEFORM_CREATOR_WALKTHROUGH_OUTPUT:-}"
APP_BUNDLE="${TAKEFORM_CREATOR_WALKTHROUGH_APP:-}"
SOURCE_SHA="${TAKEFORM_CREATOR_WALKTHROUGH_SOURCE_SHA:-}"
TEST_ROOT="${TAKEFORM_CREATOR_WALKTHROUGH_ROOT:-}"
TIMEOUT_SECONDS="${TAKEFORM_CREATOR_WALKTHROUGH_TIMEOUT_SECONDS:-180}"
ONLY_TESTING="${TAKEFORM_CREATOR_WALKTHROUGH_ONLY_TESTING:-}"

if [ "$MODE" != "run" ] && [ "$MODE" != "--build-for-testing" ] && [ "$MODE" != "--validate-runner-paths" ]; then
  echo "Usage: $0 [--build-for-testing|--validate-runner-paths]" >&2
  exit 2
fi
if [ -z "$OUTPUT_DIR" ]; then
  echo "TAKEFORM_CREATOR_WALKTHROUGH_OUTPUT is required" >&2
  exit 2
fi
if ! [[ "$TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]]; then
  echo "TAKEFORM_CREATOR_WALKTHROUGH_TIMEOUT_SECONDS must be a positive integer" >&2
  exit 2
fi
if [ ! -d "$PROJECT" ]; then
  echo "Missing UI test project: $PROJECT" >&2
  exit 2
fi
if [ "$MODE" = run ] && [ ! -d "$APP_BUNDLE" ]; then
  echo "TAKEFORM_CREATOR_WALKTHROUGH_APP must name a copied app bundle" >&2
  exit 2
fi
if [ "$MODE" = run ] && [ -z "$TEST_ROOT" ]; then
  echo "TAKEFORM_CREATOR_WALKTHROUGH_ROOT is required" >&2
  exit 2
fi

RUNNER_TEMP_PHYSICAL=""
canonical_runner_descendant() {
  local candidate="$1"
  local label="$2"
  local resolved

  resolved="$(python3 - "$RUNNER_TEMP_PHYSICAL" "$candidate" <<'PY'
import sys
from pathlib import Path

runner = Path(sys.argv[1]).resolve(strict=True)
candidate = Path(sys.argv[2])
if not candidate.is_absolute():
    raise SystemExit("candidate must be absolute")
resolved = candidate.resolve(strict=False)
try:
    resolved.relative_to(runner)
except ValueError:
    raise SystemExit("candidate escapes RUNNER_TEMP")
if resolved == runner:
    raise SystemExit("candidate must be a descendant of RUNNER_TEMP")
print(resolved)
PY
)" || { echo "$label must be an absolute, canonical descendant of RUNNER_TEMP" >&2; return 2; }
  printf '%s\n' "$resolved"
}

if [ "$MODE" = run ] || [ "$MODE" = "--validate-runner-paths" ]; then
  [ -n "${RUNNER_TEMP:-}" ] || { echo "RUNNER_TEMP is required for run mode" >&2; exit 2; }
  if ! RUNNER_TEMP_PHYSICAL="$(python3 - "$RUNNER_TEMP" <<'PY'
from pathlib import Path
import sys
print(Path(sys.argv[1]).resolve(strict=True))
PY
)"; then
    echo "RUNNER_TEMP could not be resolved" >&2
    exit 2
  fi
  if ! OUTPUT_DIR="$(canonical_runner_descendant "$OUTPUT_DIR" "TAKEFORM_CREATOR_WALKTHROUGH_OUTPUT")"; then
    exit 2
  fi
  if ! TEST_ROOT="$(canonical_runner_descendant "$TEST_ROOT" "TAKEFORM_CREATOR_WALKTHROUGH_ROOT")"; then
    exit 2
  fi
fi
if [ -n "$ONLY_TESTING" ] && { [ "$MODE" != run ] || ! [[ "$ONLY_TESTING" =~ ^TakeformNativeCreatorWalkthroughTests/TakeformNativeCreatorWalkthroughTests/test[A-Za-z0-9_]+$ ]]; }; then
  echo "TAKEFORM_CREATOR_WALKTHROUGH_ONLY_TESTING is only supported for an exact creator XCTest method in run mode" >&2
  exit 2
fi

if [ "$MODE" = "--validate-runner-paths" ]; then
  exit 0
fi

mkdir -p "$OUTPUT_DIR"
if [ "$MODE" = run ]; then
  mkdir -p "$TEST_ROOT"
  if ! revalidated_output="$(canonical_runner_descendant "$OUTPUT_DIR" "TAKEFORM_CREATOR_WALKTHROUGH_OUTPUT")"; then
    exit 2
  fi
  if ! revalidated_root="$(canonical_runner_descendant "$TEST_ROOT" "TAKEFORM_CREATOR_WALKTHROUGH_ROOT")"; then
    exit 2
  fi
  [ "$OUTPUT_DIR" = "$revalidated_output" ] || { echo "output path changed after creation" >&2; exit 2; }
  [ "$TEST_ROOT" = "$revalidated_root" ] || { echo "test root changed after creation" >&2; exit 2; }
fi
RESULT_BUNDLE="$OUTPUT_DIR/native-creator-walkthrough.xcresult"
DERIVED_DATA="$OUTPUT_DIR/DerivedData"
LOG="$OUTPUT_DIR/xcodebuild.log"
FACTS="$OUTPUT_DIR/facts.txt"
ATTACHMENTS="$OUTPUT_DIR/attachments"
LAUNCH_DIAGNOSTICS="$OUTPUT_DIR/launch-diagnostics"

rm -rf "$RESULT_BUNDLE" "$DERIVED_DATA" "$ATTACHMENTS" "$LAUNCH_DIAGNOSTICS"
{
  echo "source_sha: ${SOURCE_SHA:-$(git -C "$ROOT_DIR" rev-parse HEAD)}"
  echo "actual_source_sha: $(git -C "$ROOT_DIR" rev-parse HEAD)"
  echo "mode: $MODE"
  echo "test_root: ${TEST_ROOT:-not_applicable}"
  if [ "$MODE" = run ]; then
    echo "runner_temp: $RUNNER_TEMP_PHYSICAL"
    echo "safe_output: $OUTPUT_DIR"
    echo "safe_test_root: $TEST_ROOT"
    echo "xctest_selection: ${ONLY_TESTING:-all_creator_walkthrough_cases}"
  fi
  xcodebuild -version
  sw_vers
  uname -m
  if [ "$MODE" = run ]; then
    /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$APP_BUNDLE/Contents/Info.plist"
    codesign -dvvv "$APP_BUNDLE" 2>&1 | grep -E 'Identifier=|CDHash=' || true
  fi
} > "$FACTS" 2>&1

action="test"
if [ "$MODE" = "--build-for-testing" ]; then
  action="build-for-testing"
fi
command=(
  xcodebuild "$action"
  -project "$PROJECT"
  -scheme "$SCHEME"
  -destination 'platform=macOS,arch=arm64'
  -parallel-testing-enabled NO
  -derivedDataPath "$DERIVED_DATA"
  -resultBundlePath "$RESULT_BUNDLE"
)
if [ -n "$ONLY_TESTING" ]; then
  command+=("-only-testing:$ONLY_TESTING")
fi

log_pid=""
attempt_marker=""
attempt_start_epoch=""
if [ "$MODE" = run ]; then
  mkdir -p "$LAUNCH_DIAGNOSTICS/crash-reports"
  attempt_marker="$LAUNCH_DIAGNOSTICS/attempt-start"
  : > "$attempt_marker"
  attempt_start_epoch="$(date +%s)"
  {
    echo "attempt_start_utc: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "attempt_start_epoch: $attempt_start_epoch"
    otool -L "$APP_BUNDLE/Contents/MacOS/Takeform"
  } >> "$FACTS" 2>&1
  /usr/bin/log stream --style compact --level debug --predicate 'process == "Takeform"' > "$LAUNCH_DIAGNOSTICS/takeform-unified.log" 2>&1 &
  log_pid=$!
fi
set -m
if [ "$MODE" = run ]; then
  TEST_RUNNER_TAKEFORM_CREATOR_WALKTHROUGH_APP="$APP_BUNDLE" \
    TEST_RUNNER_TAKEFORM_CREATOR_WALKTHROUGH_ROOT="$TEST_ROOT" \
    "${command[@]}" > "$LOG" 2>&1 &
else
  "${command[@]}" > "$LOG" 2>&1 &
fi
pid=$!

collect_descendants() {
  local parent="$1"
  local child
  while IFS= read -r child; do
    [ -n "$child" ] || continue
    collect_descendants "$child"
    printf '%s\n' "$child"
  done < <(/usr/bin/pgrep -P "$parent" 2>/dev/null || true)
}

terminate_owned_processes() {
  local child
  local descendants=()
  while IFS= read -r child; do
    descendants+=("$child")
  done < <(collect_descendants "$pid")

  echo "timeout_cleanup: terminate requested" >> "$FACTS"
  kill -TERM -- "-$pid" 2>/dev/null || true
  if [ "${#descendants[@]}" -gt 0 ]; then
    kill -TERM "${descendants[@]}" 2>/dev/null || true
  fi
  sleep 2

  local survivors=()
  for child in "$pid" "${descendants[@]}"; do
    if kill -0 "$child" 2>/dev/null; then
      survivors+=("$child")
    fi
  done
  if [ "${#survivors[@]}" -gt 0 ]; then
    kill -KILL "${survivors[@]}" 2>/dev/null || true
    echo "timeout_cleanup: forced reaping for ${#survivors[@]} owned process(es)" >> "$FACTS"
  else
    echo "timeout_cleanup: all owned processes exited after TERM" >> "$FACTS"
  fi
}

deadline=$((SECONDS + TIMEOUT_SECONDS))
timed_out=0
while kill -0 "$pid" 2>/dev/null; do
  if [ "$SECONDS" -ge "$deadline" ]; then
    timed_out=1
    terminate_owned_processes
    break
  fi
  sleep 1
done
wait "$pid"
status=$?

if [ -n "$log_pid" ]; then
  kill -TERM "$log_pid" 2>/dev/null || true
  wait "$log_pid" 2>/dev/null || true
fi
if [ "$MODE" = run ]; then
  attempt_end_epoch="$(date +%s)"
  {
    echo "attempt_end_utc: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "attempt_end_epoch: $attempt_end_epoch"
  } >> "$FACTS"
  python3 - "$HOME/Library/Logs/DiagnosticReports" "$attempt_start_epoch" "$attempt_end_epoch" "$LAUNCH_DIAGNOSTICS/crash-reports" <<'PY' >> "$FACTS" 2>&1 || true
import datetime as dt
import json
import re
import shutil
import sys
from pathlib import Path

reports = Path(sys.argv[1])
start = float(sys.argv[2])
end = float(sys.argv[3])
destination = Path(sys.argv[4])
if not reports.is_dir():
    print("matching_takeform_crash_reports: diagnostic-report-directory-unavailable")
    raise SystemExit(0)

def timestamp(text: str) -> float | None:
    try:
        return dt.datetime.fromisoformat(text.replace("Z", "+00:00")).timestamp()
    except ValueError:
        pass
    for pattern in ("%Y-%m-%d %H:%M:%S.%f %z", "%Y-%m-%d %H:%M:%S %z"):
        try:
            return dt.datetime.strptime(text, pattern).timestamp()
        except ValueError:
            continue
    return None

copied = 0
for report in sorted(reports.glob("Takeform*")):
    if report.suffix not in {".ips", ".crash"} or not report.is_file():
        continue
    text = report.read_text(errors="replace")
    process = None
    incident = None
    try:
        payload = json.loads(text)
        process = payload.get("procName")
        incident = timestamp(str(payload.get("captureTime", "")))
    except json.JSONDecodeError:
        process_match = re.search(r"^Process:\s*([^\s]+)", text, re.MULTILINE)
        time_match = re.search(r"^Date/Time:\s*(.+)$", text, re.MULTILINE)
        process = process_match.group(1) if process_match else None
        incident = timestamp(time_match.group(1).strip()) if time_match else None
    if process == "Takeform" and incident is not None and start <= incident <= end:
        shutil.copy2(report, destination / report.name)
        copied += 1
        print(f"matching_takeform_crash_report: copied {report.name}")
    else:
        print(f"matching_takeform_crash_report: omitted {report.name} identity_or_time_outside_attempt")
print(f"matching_takeform_crash_report_count: {copied}")
PY
  if [ -d "$RESULT_BUNDLE/Staging" ]; then
    find "$RESULT_BUNDLE/Staging" -type f -name 'Session-*.log' -exec grep -H -E 'com\.takeform\.app@.*pid:|com\.takeform\.app \(pid:' {} + > "$LAUNCH_DIAGNOSTICS/xctest-takeform-pid-observations.txt" 2>/dev/null || true
  else
    : > "$LAUNCH_DIAGNOSTICS/xctest-takeform-pid-observations.txt"
  fi
  if [ ! -s "$LAUNCH_DIAGNOSTICS/xctest-takeform-pid-observations.txt" ]; then
    echo "takeform_pid_observation: absent from retained XCTest diagnostics" >> "$FACTS"
  else
    echo "takeform_pid_observation: retained in launch-diagnostics/xctest-takeform-pid-observations.txt" >> "$FACTS"
  fi
fi

if [ "$timed_out" -eq 1 ]; then
  echo "probe_timeout_seconds: $TIMEOUT_SECONDS" >> "$FACTS"
  status=124
fi
if [ -d "$RESULT_BUNDLE" ]; then
  if [ "$MODE" = run ]; then
    mkdir -p "$ATTACHMENTS"
    if ! xcrun xcresulttool export attachments --path "$RESULT_BUNDLE" --output-path "$ATTACHMENTS" >> "$LOG" 2>&1; then
      echo "attachment_export: failed" >> "$FACTS"
      status=1
    fi
  else
    echo "attachment_export: not_applicable" >> "$FACTS"
  fi
else
  echo "result_bundle: missing" >> "$FACTS"
  status=1
fi
if [ "$MODE" = run ] && ! find "$ATTACHMENTS" -type f -name '*.png' -print -quit | grep -q .; then
  echo "window_screenshot: missing" >> "$FACTS"
  status=1
fi

exit "$status"
