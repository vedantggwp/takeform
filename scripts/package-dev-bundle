#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
DESTINATION_DIR="$ROOT_DIR/dist"
RENDERER_NODE_ROOT=""
RENDERER_RUNTIME_SOURCE=""

usage() {
  cat >&2 <<'USAGE'
usage: package-dev-bundle [DESTINATION] [--renderer-node-root ABSOLUTE_DIRECTORY --renderer-runtime-source ABSOLUTE_DIRECTORY]

Both renderer options are required together. The node root must be a
self-contained Node 22.22.1 runtime with bin/node; the runtime source must be
the installed lock-derived renderer runtime. Neither value is discovered.
USAGE
  exit 64
}

if [ "$#" -gt 0 ] && [ "${1#--}" = "$1" ]; then
  DESTINATION_DIR="$1"
  shift
fi
while [ "$#" -gt 0 ]; do
  case "$1" in
    --renderer-node-root)
      [ "$#" -ge 2 ] || usage
      RENDERER_NODE_ROOT="$2"
      shift 2
      ;;
    --renderer-runtime-source)
      [ "$#" -ge 2 ] || usage
      RENDERER_RUNTIME_SOURCE="$2"
      shift 2
      ;;
    *) usage ;;
  esac
done

if [ -n "$RENDERER_NODE_ROOT" ] && [ -z "$RENDERER_RUNTIME_SOURCE" ] || [ -z "$RENDERER_NODE_ROOT" ] && [ -n "$RENDERER_RUNTIME_SOURCE" ]; then
  usage
fi

require_absolute_directory() {
  case "$2" in /*) ;; *) echo "$1 must be an absolute directory." >&2; exit 64 ;; esac
  [ -d "$2" ] || { echo "$1 is not a directory." >&2; exit 64; }
}

assert_self_contained_node() {
  local node_root="$1"
  local candidate dependency
  while IFS= read -r -d '' candidate; do
    while IFS= read -r dependency; do
      case "$dependency" in
        /System/Library/*|/usr/lib/*|@rpath/*|@loader_path/*|@executable_path/*) ;;
        *) echo "Renderer Node has an external dynamic-library dependency: $dependency" >&2; exit 65 ;;
      esac
    done < <(otool -L "$candidate" | tail -n +2 | sed -E 's/^[[:space:]]*([^[:space:]]+).*/\1/')
  done < <(find "$node_root/bin" "$node_root/lib" -type f \( -name '*.dylib' -o -name node \) -print0 2>/dev/null)
}

if [ -n "$RENDERER_NODE_ROOT" ]; then
  require_absolute_directory "--renderer-node-root" "$RENDERER_NODE_ROOT"
  require_absolute_directory "--renderer-runtime-source" "$RENDERER_RUNTIME_SOURCE"
  RENDERER_NODE="$RENDERER_NODE_ROOT/bin/node"
  [ -x "$RENDERER_NODE" ] || { echo "Renderer Node root has no executable bin/node." >&2; exit 64; }
  [ -f "$RENDERER_RUNTIME_SOURCE/package-lock.json" ] && [ -d "$RENDERER_RUNTIME_SOURCE/node_modules" ] || { echo "Renderer runtime source is incomplete." >&2; exit 64; }
  assert_self_contained_node "$RENDERER_NODE_ROOT"
  EXPECTED_NODE_VERSION="$("$RENDERER_NODE" -e 'process.stdout.write(JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8")).nodeVersion)' "$ROOT_DIR/renderer/runtime-profile.json")"
  ACTUAL_NODE_VERSION="$("$RENDERER_NODE" --version)"
  [ "$ACTUAL_NODE_VERSION" = "$EXPECTED_NODE_VERSION" ] || { echo "Renderer Node version does not match runtime-profile.json." >&2; exit 65; }
  "$RENDERER_NODE" "$ROOT_DIR/comparisons/runtime/doctor.mjs" --runtime "$RENDERER_RUNTIME_SOURCE" --package-only
fi
APP_BUNDLE="$DESTINATION_DIR/Takeform.app"

mkdir -p "$DESTINATION_DIR"
swift build --package-path "$ROOT_DIR" -c release --product TakeformApp
swift build --package-path "$ROOT_DIR" -c release --product TakeformDoctor
swift build --package-path "$ROOT_DIR" -c release --product TakeformAuthorityAppService
swift build --package-path "$ROOT_DIR" -c release --product takeform
BIN_DIR="$(swift build --package-path "$ROOT_DIR" -c release --show-bin-path)"

bundle_identifier=""
display_name=""
development_version=""
minimum_system_version=""
while IFS='=' read -r key value; do
  case "$key" in
    bundleIdentifier) bundle_identifier="$value" ;;
    displayName) display_name="$value" ;;
    developmentVersion) development_version="$value" ;;
    minimumSystemVersion) minimum_system_version="$value" ;;
  esac
done < <("$BIN_DIR/TakeformDoctor" identity)

if [ -z "$bundle_identifier" ] || [ -z "$display_name" ] || [ -z "$development_version" ] || [ -z "$minimum_system_version" ]; then
  echo "TakeformDoctor did not provide complete product metadata." >&2
  exit 1
fi

rm -rf "$APP_BUNDLE"
mkdir -p "$APP_BUNDLE/Contents/MacOS" "$APP_BUNDLE/Contents/Resources"
# Keep the GUI executable distinct from the lowercase CLI. APFS is commonly
# case-insensitive, so `Takeform` and `takeform` would otherwise be one path
# and the second copy would silently replace the app with the CLI.
cp "$BIN_DIR/TakeformApp" "$APP_BUNDLE/Contents/MacOS/TakeformApp"
cp "$BIN_DIR/TakeformAuthorityAppService" "$APP_BUNDLE/Contents/MacOS/TakeformAuthorityAppService"
cp "$BIN_DIR/takeform" "$APP_BUNDLE/Contents/MacOS/takeform"
# Verify the copied product bytes before the bundle signature changes the main
# executable. This specifically catches case-folded path replacement.
[ "$(shasum -a 256 "$BIN_DIR/TakeformApp" | awk '{print $1}')" = "$(shasum -a 256 "$APP_BUNDLE/Contents/MacOS/TakeformApp" | awk '{print $1}')" ]
[ "$(shasum -a 256 "$BIN_DIR/takeform" | awk '{print $1}')" = "$(shasum -a 256 "$APP_BUNDLE/Contents/MacOS/takeform" | awk '{print $1}')" ]
[ "$(stat -f '%d:%i' "$APP_BUNDLE/Contents/MacOS/TakeformApp")" != "$(stat -f '%d:%i' "$APP_BUNDLE/Contents/MacOS/takeform")" ]
cp "$ROOT_DIR/design/identity/exports/Takeform.icns" "$APP_BUNDLE/Contents/Resources/Takeform.icns"

if [ -n "$RENDERER_NODE_ROOT" ]; then
  RENDERER_BUNDLE="$APP_BUNDLE/Contents/Resources/RendererRuntime"
  mkdir -p "$RENDERER_BUNDLE"
  ditto "$RENDERER_NODE_ROOT" "$RENDERER_BUNDLE/node"
  ditto "$RENDERER_RUNTIME_SOURCE/node_modules" "$RENDERER_BUNDLE/node_modules"
  cp "$RENDERER_RUNTIME_SOURCE/package.json" "$RENDERER_RUNTIME_SOURCE/package-lock.json" "$RENDERER_BUNDLE/"
  # The package-owned doctor is the verifier contract. The external runtime
  # supplies only pinned dependencies and must not override it.
  cp "$ROOT_DIR/comparisons/runtime/doctor.mjs" "$RENDERER_BUNDLE/doctor.mjs"
  cp "$ROOT_DIR/renderer/episode-render-worker.mjs" "$ROOT_DIR/renderer/runtime-profile.json" "$RENDERER_BUNDLE/"
  mkdir -p "$RENDERER_BUNDLE/tools"
  cp "$ROOT_DIR/renderer/launchers/secure-browser-launcher.sh" "$RENDERER_BUNDLE/tools/secure-browser-launcher.sh"
  chmod 755 "$RENDERER_BUNDLE/tools/secure-browser-launcher.sh"
  EXPECTED_RENDERER_HASHES="$($RENDERER_NODE -e '
    const fs = require("node:fs");
    const profile = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    const entry = profile.launchers?.find((candidate) => candidate.kind === "browser");
    if (!entry || entry.path !== "tools/secure-browser-launcher.sh" || !/^[a-f0-9]{64}$/.test(entry.sha256 ?? "") || profile.worker?.path !== "episode-render-worker.mjs" || !/^[a-f0-9]{64}$/.test(profile.worker.sha256 ?? "")) process.exit(64);
    process.stdout.write(`${entry.sha256} ${profile.worker.sha256}`);
  ' "$ROOT_DIR/renderer/runtime-profile.json")"
  read -r EXPECTED_BROWSER_WRAPPER_SHA EXPECTED_WORKER_SHA <<< "$EXPECTED_RENDERER_HASHES"
  [ "$(shasum -a 256 "$RENDERER_BUNDLE/tools/secure-browser-launcher.sh" | awk '{print $1}')" = "$EXPECTED_BROWSER_WRAPPER_SHA" ] || { echo "Renderer browser wrapper does not match runtime-profile.json." >&2; exit 65; }
  [ "$(shasum -a 256 "$RENDERER_BUNDLE/episode-render-worker.mjs" | awk '{print $1}')" = "$EXPECTED_WORKER_SHA" ] || { echo "Renderer worker does not match runtime-profile.json." >&2; exit 65; }
fi

cat >"$APP_BUNDLE/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>$display_name</string>
  <key>CFBundleExecutable</key>
  <string>TakeformApp</string>
  <key>CFBundleIconFile</key>
  <string>Takeform</string>
  <key>CFBundleIdentifier</key>
  <string>$bundle_identifier</string>
  <key>CFBundleName</key>
  <string>$display_name</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>LSMinimumSystemVersion</key>
  <string>$minimum_system_version</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSPrincipalClass</key>
  <string>NSApplication</string>
  <key>TakeformDevelopmentVersion</key>
  <string>$development_version</string>
</dict>
</plist>
PLIST

"$BIN_DIR/TakeformDoctor" verify-identity "$APP_BUNDLE/Contents/Info.plist"
codesign --force --options runtime --sign - --identifier "$bundle_identifier" "$APP_BUNDLE"
codesign --verify --deep --strict --verbose=2 "$APP_BUNDLE"
echo "$APP_BUNDLE"
